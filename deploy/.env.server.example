# 复制为 ~/tfsj/deploy/.env 后按现场修改

# 日志：WARNING 减少刷屏，stop/cancel 等 warning 更醒目；细查可改 INFO/DEBUG
LOG_LEVEL=WARNING
UVICORN_LOG_LEVEL=warning

# autoheal：compose --profile autoheal up -d；unhealthy 时自动 restart bettafish/mock
AUTOHEAL_IMAGE=willfarrell/autoheal:latest
AUTOHEAL_INTERVAL=15
AUTOHEAL_START_PERIOD=120

# ====================== 达梦（容器经 host.docker.internal 连宿主机）======================
DB_HOST=host.docker.internal
DB_PORT=5237
DB_USER=SYSDBA
DB_PASSWORD=your_value_here
DB_NAME=qiyuan
DM_CURRENT_SCHEMA=mindspider_war
DB_CHARSET=utf8
ENABLE_DB_FALLBACK=false

# MindSpider zip 导入：解压目录须与 compose volume 一致（宿主机 ./exports/crawl_import）
CRAWL_IMPORT_EXTRACT_DIR=/app/exports/crawl_import
CRAWL_IMPORT_SCHEMA=mindspider_war
CRAWL_IMPORT_MAX_UPLOAD_MB=512
CRAWL_IMPORT_BATCH_SIZE=100

# ======================= LLM（内网 vLLM）======================
INSIGHT_ENGINE_API_KEY=your_value_here
INSIGHT_ENGINE_BASE_URL=http://192.168.1.10:8000/v1
INSIGHT_ENGINE_MODEL_NAME=Qwen3-30B-A3B-Instruct-2507

MEDIA_ENGINE_API_KEY=your_value_here
MEDIA_ENGINE_BASE_URL=http://192.168.1.10:8000/v1
MEDIA_ENGINE_MODEL_NAME=Qwen3-30B-A3B-Instruct-2507

QUERY_ENGINE_API_KEY=your_value_here
QUERY_ENGINE_BASE_URL=http://192.168.1.10:8000/v1
QUERY_ENGINE_MODEL_NAME=Qwen3-30B-A3B-Instruct-2507

REPORT_ENGINE_API_KEY=your_value_here
REPORT_ENGINE_BASE_URL=http://192.168.1.10:8000/v1
REPORT_ENGINE_MODEL_NAME=Qwen3-30B-A3B-Instruct-2507

# ================== Mock 搜索（容器内用服务名 mock-search-api）====================
TAVILY_API_KEY=your_value_here
TAVILY_BASE_URL=http://mock-search-api:8787/tavily
ANSPIRE_BASE_URL=http://mock-search-api:8787/anspire/search
ANSPIRE_API_KEY=your_value_here
SEARCH_TOOL_TYPE=AnspireAPI

# ================== 知识库（dataplatform RAG）====================
# knowledge_base_ids 直接传 dataset_id，无需 KNOWLEDGE_BASE_DATASET_MAP
KNOWLEDGE_BASE_API_BASE_URL=http://192.168.1.10:8081
KNOWLEDGE_BASE_API_KEY=your_value_here
KNOWLEDGE_BASE_TOP_K=8
KNOWLEDGE_BASE_TIMEOUT_SEC=30
SINGLE_AGENT_REPORT_LLM_TIMEOUT_SEC=135
SINGLE_AGENT_REPORT_LLM_TEMPERATURE=0.2
SINGLE_AGENT_REPORT_RETRIEVAL_BUDGET_SEC=120
SINGLE_AGENT_PIPELINE_TIMEOUT_SEC=300

# ================== event2 必配（甲方演示）====================
# 其余 REPORT_AGENT_* / TROOPS_AGENT_* 微调项有代码默认值，勿抄全。
# 可选参数清单见 docs/REPORT_AGENT_SPEC.md §9
EVENT2_DATA_SOURCE=agent
REPORT_AGENT_MODE=agent
EVENT2_DEMO_MODE=true
DM_MCP_SCHEMA=TROOPS_2_ENHANCED

# ================== 会话历史（Agent Open API 按条追加）====================
SESSION_HISTORY_API_BASE_URL=http://192.168.1.10:8081
SESSION_HISTORY_API_KEY=your_value_here
SESSION_HISTORY_AGENT_ID=5
SESSION_HISTORY_TIMEOUT_SEC=8

# ================== 对外开放事件列表（代理平台 8250）====================
OPEN_EVENTS_SOURCE=upstream
OPEN_EVENTS_UPSTREAM_BASE_URL=http://192.168.1.157:8250
OPEN_EVENTS_UPSTREAM_TIMEOUT_SEC=15
OPEN_EVENTS_FALLBACK_MOCK=false

# ================== EventReport（敏感展开 / impact）====================
EVENT_REPORT_DM_ENABLED=true
# 甲方演示：无库数据也返回饱满样例；正式严肃验收改 false
EVENT_REPORT_DEMO_MODE=true
# 演示模式只查该评论表（不按机密标题过滤）
EVENT_REPORT_DEMO_COMMENT_TABLE=weibo_note_comment_copy1
EVENT_REPORT_LLM_ENABLED=true
EVENT_REPORT_LLM_TIMEOUT_SEC=8
EVENT_REPORT_CACHE_TTL_SEC=300

# 卫鼎智能体模板（event2 列表/详情；更新由前端直连）
AGENT_TEMPLATE_API_BASE_URL=http://192.168.1.10:8090
AGENT_TEMPLATE_API_KEY=your_value_here
AGENT_TEMPLATE_TIMEOUT_SEC=15
AGENT_TEMPLATE_SOURCE=remote
# auto=BASE_URL 非空则 remote；local=仅本机 report_templates
# remote 时空库/失败回退本地，不阻断报告生成
# AGENT_TEMPLATE_SOURCE=auto
# AGENT_TEMPLATE_SOURCE=local

# 厂家舆情采集（本服务对外进度接口 + MindSpider）
OPINION_CRAWL_TRIGGER_MINDSPIDER=true
OPINION_CRAWL_PLATFORMS=wb
OPINION_CRAWL_LOGIN_TYPE=cookie
OPINION_CRAWL_PLACEHOLDER_COMPLETE=false

GRAPHRAG_ENABLED=false
