# ====================== 日志 ======================
# TRACE/DEBUG/INFO/SUCCESS/WARNING/ERROR/CRITICAL；默认 WARNING，关键事件更清晰
LOG_LEVEL=WARNING
# uvicorn 访问/框架日志（与上可分开）；默认 warning
UVICORN_LOG_LEVEL=warning
# SSE agent_log 转发等级（不设则跟随 LOG_LEVEL）
# SSE_LOG_LEVEL=INFO
# event2 独立线程池（避免多次中途「新对话」占满 anyio 默认池导致整站罢工）
# EVENT2_STREAM_MAX_WORKERS=12
# EVENT2_MAX_CONCURRENT_STREAMS=8
# EVENT2_PREFLIGHT_WORKERS=4
# EVENT2_PREFLIGHT_TIMEOUT_SEC=5
# 本地演示页跨域：file:// 需含 null；http.server 8765 等可写进白名单或靠下方正则
# CORS_ALLOW_ORIGINS=null,http://127.0.0.1:5500,http://localhost:5500,http://127.0.0.1:8765
# CORS_ALLOW_ORIGIN_REGEX=https?://(localhost|127\.0\.0\.1|\[::1\]|192\.168\.\d{1,3}\.\d{1,3})(:\d+)?$
# BETTAFISH 主机地址，默认为5000
PORT=5000

# ====================== 数据库配置 ======================
# 数据库主机，例如localhost 或 127.0.0.1
DB_HOST=your_db_host
# 数据库端口号，默认为3306
DB_PORT=3306
# 数据库用户名
DB_USER=your_db_user
# 数据库密码
DB_PASSWORD=your_db_password
# 数据库名称
DB_NAME=your_db_name
# 数据库字符集，推荐utf8mb4，兼容emoji
DB_CHARSET=utf8mb4
# 数据库类型mysql或postgresql
DB_DIALECT=postgresql

# ======================= LLM 相关 =======================
# 您可以更改每个部分LLM使用的API，🚩只要兼容OpenAI请求格式都可以，定义好KEY、BASE_URL与MODEL_NAME即可正常使用。
# 重要提醒：我们强烈推荐您先使用推荐的配置申请API，先跑通再进行您的更改！
# 我们的LLM模型API赞助商有：https://aihubmix.com/?aff=8Ds9，提供了非常全面的模型api

# Insight Agent（推荐kimi-k2，官方申请地址：https://platform.moonshot.cn/）
INSIGHT_ENGINE_API_KEY=
INSIGHT_ENGINE_BASE_URL=
INSIGHT_ENGINE_MODEL_NAME=

# Media Agent（推荐gemini-2.5-pro，中转厂商申请地址：https://aihubmix.com/?aff=8Ds9）
MEDIA_ENGINE_API_KEY=
MEDIA_ENGINE_BASE_URL=
MEDIA_ENGINE_MODEL_NAME=
# 图片识别可独立配置；留空使用上述 Media 配置（需支持图片输入）
DISCUSSION_VISION_API_KEY=
DISCUSSION_VISION_BASE_URL=
DISCUSSION_VISION_MODEL_NAME=

# Query Agent（推荐deepseek-chat，官方申请地址：https://platform.deepseek.com/）
QUERY_ENGINE_API_KEY=
QUERY_ENGINE_BASE_URL=
QUERY_ENGINE_MODEL_NAME=

# Report Agent（推荐gemini-2.5-pro，中转厂商申请地址：https://aihubmix.com/?aff=8Ds9）
# 注意：Report Agent需要相对较强的模型能力，若最终报告出现图表空白/段落异常的情况，请尝试更换更强的模型
REPORT_ENGINE_API_KEY=
REPORT_ENGINE_BASE_URL=
REPORT_ENGINE_MODEL_NAME=

# MindSpider Agent（推荐deepseek-chat，官方申请地址：https://platform.deepseek.com/）
MINDSPIDER_API_KEY=
MINDSPIDER_BASE_URL=
MINDSPIDER_MODEL_NAME=

# 论坛主持人（推荐qwen-plus，官方申请地址：https://www.aliyun.com/product/bailian）
FORUM_HOST_API_KEY=
FORUM_HOST_BASE_URL=
FORUM_HOST_MODEL_NAME=

# SQL Keyword Optimizer（推荐qwen-plus，官方申请地址：https://www.aliyun.com/product/bailian）
KEYWORD_OPTIMIZER_API_KEY=
KEYWORD_OPTIMIZER_BASE_URL=
KEYWORD_OPTIMIZER_MODEL_NAME=

# ================== 网络工具配置 ====================
# Query独立选择搜索服务：tavily、anspire、bocha
QUERY_SEARCH_PROVIDER=tavily
# 博查网页搜索地址，仅用于Query；Media的AI Search使用BOCHA_BASE_URL
QUERY_BOCHA_BASE_URL=https://api.bocha.cn/v1/web-search
# Tavily API密钥，用于Tavily网络搜索，申请地址：https://www.tavily.com/
TAVILY_API_KEY=

# 网络搜索工具类型，支持BochaAPI或AnspireAPI两种，默认为AnspireAPI
SEARCH_TOOL_TYPE=AnspireAPI

# Anspire AI Search API（申请地址：https://open.anspire.cn/，相同效果下费用是Bocha的一半）
ANSPIRE_BASE_URL=https://plugin.anspire.cn/api/ntsearch/search
ANSPIRE_API_KEY=

# Bocha AI Search API（用于Bocha多模态搜索，这里密钥名称虽然是Web Search，但其实是要AI Search的，申请地址：https://open.bochaai.com/）
BOCHA_BASE_URL=https://api.bocha.cn/v1/ai-search
BOCHA_WEB_SEARCH_API_KEY=

# ================== 知识库（dataplatform RAG）====================
# Agent Open API 基址（内网示例：http://192.168.1.10:8081）
# 请求体 knowledge_base_ids 直接传 dataset_id 字符串，无需整数映射
KNOWLEDGE_BASE_API_BASE_URL=http://192.168.1.10:8081
KNOWLEDGE_BASE_API_KEY=
KNOWLEDGE_BASE_TOP_K=8
KNOWLEDGE_BASE_TIMEOUT_SEC=30
SINGLE_AGENT_REPORT_LLM_TIMEOUT_SEC=135
SINGLE_AGENT_REPORT_LLM_TEMPERATURE=0.2
SINGLE_AGENT_REPORT_RETRIEVAL_BUDGET_SEC=120
SINGLE_AGENT_PIPELINE_TIMEOUT_SEC=300

# event2 必配（演示）：其余微调见 docs/REPORT_AGENT_SPEC.md §9，勿抄全
EVENT2_DATA_SOURCE=agent
REPORT_AGENT_MODE=agent
EVENT2_DEMO_MODE=true
DM_MCP_SCHEMA=TROOPS_2_ENHANCED
# stop 时关闭 LLM 流的最长等待（秒）；超时则后台继续关，避免拖死事件循环
EVENT2_CLOSER_JOIN_TIMEOUT_SEC=2
# /health 探测 mock 的超时（秒）；切勿设成数百秒
HEALTH_MOCK_TIMEOUT_SEC=2

# ================== 会话历史（Agent Open API 按条追加）====================
# POST /api/v1/ai/session/open/message
# agent_id 后端写死；session_id 用前端传入的
SESSION_HISTORY_API_BASE_URL=http://192.168.1.10:8081
SESSION_HISTORY_API_KEY=
SESSION_HISTORY_AGENT_ID=5
SESSION_HISTORY_TIMEOUT_SEC=8
# 未单独配置时会回退到 KNOWLEDGE_BASE_API_BASE_URL / KNOWLEDGE_BASE_API_KEY

# ================== 对外开放事件列表（代理平台 8250）====================
# upstream=代理 8250 同名接口（事件 ID 以上游为准）；mock=本地 mock_catalog
OPEN_EVENTS_SOURCE=upstream
OPEN_EVENTS_UPSTREAM_BASE_URL=http://192.168.1.157:8250
OPEN_EVENTS_UPSTREAM_TIMEOUT_SEC=15
# 上游不可达时是否回退本地 mock（联调建议 false）
OPEN_EVENTS_FALLBACK_MOCK=false

# ================== EventReport（敏感展开 / impact）====================
# 达梦聚合热度/词云（需 DB_* + DM_CURRENT_SCHEMA=mindspider_war，且帖子已写入）
EVENT_REPORT_DM_ENABLED=true
# 演示模式：无库命中时灌满样例（贴真 title/ID）；严肃验收改 false
EVENT_REPORT_DEMO_MODE=true
# 演示模式只查此表（mindspider_war 下），不按事件标题过滤
EVENT_REPORT_DEMO_COMMENT_TABLE=weibo_note_comment_copy1
# impact 叙事短时 LLM（复用 REPORT_ENGINE_* / INSIGHT_ENGINE_*）
EVENT_REPORT_LLM_ENABLED=true
EVENT_REPORT_LLM_TIMEOUT_SEC=8
EVENT_REPORT_CACHE_TTL_SEC=300

# ================== MindSpider zip 导入达梦 ====================
# 解压落盘根目录；Docker 部署推荐 /app/exports/crawl_import（需挂 volume）
CRAWL_IMPORT_EXTRACT_DIR=exports/crawl_import
# 目标 schema（只写此 schema；导入时会解析库内真实大小写如 MINDSPIDER_WAR）
CRAWL_IMPORT_SCHEMA=mindspider_war
# 上传大小上限（MB）
CRAWL_IMPORT_MAX_UPLOAD_MB=512
# 入库批量提交行数
CRAWL_IMPORT_BATCH_SIZE=100

# ================== 厂家舆情采集（对接左屏开放事件 + MindSpider）====================
# OPINION_CRAWL_DB_PATH=
OPINION_CRAWL_TRIGGER_MINDSPIDER=true
OPINION_CRAWL_PLATFORMS=wb
OPINION_CRAWL_LOGIN_TYPE=cookie
OPINION_CRAWL_MAX_NOTES=20
# OPINION_CRAWL_BATCH_MODE=false
# OPINION_CRAWL_MINDSPIDER_DRY_RUN=false
OPINION_CRAWL_PLACEHOLDER_COMPLETE=false

# singleAgent 默认输出模板（local 源 / report_templates/manifest.json）
SINGLE_AGENT_REPORT_TEMPLATE=flexible_assistant
# 卫鼎智能体模板（open list/detail）；更新由前端直连 8090
# AGENT_TEMPLATE_SOURCE=auto  # auto|remote|local；auto=BASE_URL 非空则 remote
# remote 时空库/失败会回退本地 report_templates，不阻断 ismodel=1
AGENT_TEMPLATE_API_BASE_URL=http://192.168.1.10:8090
AGENT_TEMPLATE_API_KEY=
AGENT_TEMPLATE_TIMEOUT_SEC=15
# 全局可写报告模板目录（与 session 无关；默认同仓库 logs/custom_report_templates）
# CUSTOM_REPORT_TEMPLATES_DIR=/data/bettafish/custom_report_templates
# 兼容旧名：SESSION_TEMPLATES_DIR=/data/bettafish/custom_report_templates
# singleAgent thinking 节奏（秒；演示嫌慢可再调小，全 0 则几乎无等待）
# 成稿后整篇润色只改落盘、会拖长总耗时；验收可关
# REPORT_AGENT_POLISH=false
# SINGLE_AGENT_THINKING_PROGRESS_DELAY_SEC=0.55
# SINGLE_AGENT_THINKING_CHUNK_DELAY_SEC=0.05
# SINGLE_AGENT_SEARCH_ROUND_DELAY_SEC=0.25
# SINGLE_AGENT_PHASE_GAP_DELAY_SEC=0.35
# SINGLE_AGENT_PRE_LLM_DELAY_SEC=0.6
# SINGLE_AGENT_THINKING_SUMMARY_MAX_CHUNKS=4
# mode=0 LLM 检索规划：默认 2 轮（主题→词 后按命中补搜）
# SINGLE_AGENT_SEARCH_PLAN_ROUNDS=2
# SINGLE_AGENT_SEARCH_PLAN_TIMEOUT_SEC=45

# ====================== event2 / MCP 可选微调（一般不用改）======================
# 必配已在上方：EVENT2_DATA_SOURCE / REPORT_AGENT_MODE / EVENT2_DEMO_MODE / DM_MCP_SCHEMA
# 可选默认值表：docs/REPORT_AGENT_SPEC.md §9、docs/TROOPS_MCP_AGENT_SPEC.md
# DM_SEARCH_BACKEND=mcp
# DM_MCP_URL=
# DM_MCP_CONTEXT_DENY_TABLES=AGENTS,AGENT_SESSION
# MCP 服务进程（server_multi.py）连接变量，可与 DB_* 相同或单独配置：
# DM_HOST=
# DM_PORT=
# DM_USERNAME=
# DM_PASSWORD=
# MULTI_DB_PORT=8002

# GraphRAG 功能开关（True/False），测试功能，默认关闭
# 开启后会构建知识图谱并在章节生成前进行图谱查询
GRAPHRAG_ENABLED=false

# GraphRAG 查询次数上限（每个章节生成前LLM可查询知识图谱的最大次数）
# 仅在 GRAPHRAG_ENABLED=True 时生效
# 一般推荐设置：2～4
GRAPHRAG_MAX_QUERIES=3
